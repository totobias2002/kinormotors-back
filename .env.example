# Copiar a .env (NO se versiona) y completar. En Railway se cargan como variables del servicio.

# Base de datos PostgreSQL (en Railway: la URL JDBC del plugin de Postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/kinormotors
SPRING_DATASOURCE_USERNAME=kinormotors
SPRING_DATASOURCE_PASSWORD=

# Secreto para firmar los JWT del admin (minimo 32 caracteres, aleatorio)
JWT_SECRET=

# Origenes permitidos por CORS, separados por coma (el dominio del front en Vercel)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Admin inicial: se crea solo si no hay ninguno (clave de al menos 10 caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

# Sal para anonimizar IPs en los leads (cualquier texto largo y secreto)
TRACKING_IP_SALT=
